  "catalogEvidencePolicy": {
    "tierSemantics": [
      {
        "tier": "documented",
        "meaning": "An official source documents an identifier or capability. It does not prove local configuration or access."
      },
      {
        "tier": "configured",
        "meaning": "The exact runner/model/effort tuple is allowlisted locally. It does not prove current account entitlement or successful execution."
      },
      {
        "tier": "runtime-entitled",
        "meaning": "A bounded, credential-safe runtime probe observed the exact tuple on this installation and account before its expiry. It does not prove phase quality."
      },
      {
        "tier": "phase-qualified",
        "meaning": "The exact tuple passed the versioned phase evaluation bound to the same phase-contract hash and capability hash before expiry."
      }
    ],
    "routeMinimum": "phase-qualified",
    "freshness": {
      "officialCatalogMaxAgeDays": 7,
      "runtimeEntitlementMaxAgeDays": 7,
      "phaseQualificationMaxAgeDays": 30,
      "expiredBehavior": "needs_input"
    },
    "unknownBehavior": "needs_input",
    "rules": [
      "Documentation, local configuration, runtime entitlement, and phase qualification are distinct evidence tiers and cannot be inferred from one another.",
      "Every routable candidate must bind runner, provider, model, reasoning effort, adapter capability hash, phase id, and phase-contract hash.",
      "A model alias is accepted only when the provider documents it as a pinned identity or the runtime probe records the resolved immutable model identity.",
      "A catalog mismatch or expired source invalidates the candidate before provider execution.",
      "No credential value, prompt body, private specification body, or provider response body belongs in catalog evidence."
    ]
  },
  "selectionPolicy": {
    "mode": "explicit-evidence-bound",
    "modelMayDecideGate": false,
    "steps": [
      "Resolve the exact phase contract and decision authority.",
      "Return no_model for model-forbidden phases and preserve their deterministic or human gate.",
      "Filter candidates by unexpired catalog evidence, current runtime entitlement, exact phase qualification, required capability superset, context fit, supported effort, adapter capability hash, and runtime-permission compatibility.",
      "Apply the operator-authored candidate order; performance may act only as a tie-breaker when its evidence policy is satisfied.",
      "Persist the selected tuple, evidence identities, policy version, and explicit reason before execution.",
      "If no candidate remains, return needs_input with zero provider execution."
    ],
    "forbidden": [
      "silent provider substitution",
      "provider or model names embedded in phase requirements",
      "treating unknown cost, latency, quality, or entitlement as zero or pass",
      "weakening human or computed gates",
      "using transport smoke as phase qualification",
      "ranking candidates from samples with different phase-contract or capability hashes"
    ]
  },
  "fallbackPolicy": {
    "allowedOnlyWhen": [
      "the fallback is independently phase-qualified for the exact phase-contract hash",
      "the fallback capability set is a superset of every required and active conditional capability",
      "the same decision authority, gate, artifact classes, evidence requirements, and runtime permission ceiling are preserved",
      "runtime entitlement and catalog evidence are unexpired",
      "the substitution reason and both exact runner/model/effort identities are persisted before retry"
    ],
    "forbiddenWhen": [
      "capability, context fit, entitlement, provenance, cost, latency, or phase qualification is unknown",
      "the failed attempt may have crossed or mutated a human/computed gate without a replay-safe phase contract",
      "the fallback requires broader runtime permissions than the approved phase envelope"
    ],
    "noEligibleFallback": "needs_input",
    "silentFallback": false
  },
  "performanceEvidencePolicy": {
    "optimizerEnabled": false,
    "currentDecision": "disabled-insufficient-phase-specific-evidence",
    "requiredObservationKey": [
      "phaseId",
      "phaseContractSha256",
      "runnerId",
      "providerId",
      "modelId",
      "reasoningEffort",
      "adapterCapabilitySha256"
    ],
    "minimumComparableCompletedRunsPerCandidate": 5,
    "maximumObservationAgeDays": 30,
    "requiredMetrics": ["trustedPhaseVerdict", "durationMs", "inputTokens", "outputTokens", "pricingStatus"],
    "rankingRules": [
      "Only phase-qualified candidates with the same observation key except runner/provider/model/effort may be compared.",
      "Quality and gate conservation are hard filters; cost and latency are tie-breakers, never substitutes for correctness.",
      "Unpriced cost, missing tokens, missing duration, rejected usage, and partial runs remain unknown and are excluded from numeric ranking.",
      "The first release uses operator-authored candidate order until every candidate meets the comparable-sample floor."
    ],
    "currentEvidenceGap": "Dashboard metrics aggregate by runner and kit version, and existing live canaries are transport/entitlement observations rather than same-phase semantic comparisons."
  },
