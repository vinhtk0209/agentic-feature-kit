{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-feature-kit.dev/schemas/conditional-quality-gates-1.0.0.json",
  "title": "Project-Derived Conditional Quality Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileFingerprint", "status", "gates", "resultHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profileFingerprint": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["pass", "fail", "needs_input"] },
    "gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/i18nGate" },
        { "$ref": "#/$defs/routerGate" },
        { "$ref": "#/$defs/styleGate" }
      ],
      "items": false
    },
    "resultHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicable", "status", "evidence", "findings"],
      "properties": {
        "id": { "type": "string" },
        "applicable": { "type": "boolean" },
        "status": { "enum": ["pass", "fail", "needs_input", "not_applicable"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "i18nGate": { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "i18n-completeness" } } }] },
    "routerGate": { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "router-registration" } } }] },
    "styleGate": { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "style-ownership" } } }] }
  }
}
