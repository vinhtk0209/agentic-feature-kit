{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-feature-kit.dev/schemas/semantic-spec-1.0.0.json",
  "title": "Provider-Neutral Semantic Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "sourceDocuments", "requirements", "contracts", "ambiguities", "semanticHash", "provenanceHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "title": { "type": ["string", "null"], "minLength": 1 },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceDocument" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
    "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/ambiguity" } },
    "semanticHash": { "$ref": "#/$defs/sha256" },
    "provenanceHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "sourceRef", "sourceSha256"],
      "properties": {
        "sourceKind": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "allOf": [
        { "$ref": "#/$defs/sourceDocument" },
        {
          "type": "object",
          "required": ["anchor", "quote"],
          "properties": {
            "anchor": { "type": "string", "minLength": 1 },
            "quote": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["given", "when", "then"],
      "properties": {
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "scenario", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "scenario": { "oneOf": [{ "$ref": "#/$defs/scenario" }, { "type": "null" }] },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "state", "values", "provenance"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "state": { "enum": ["known", "unknown", "conflict"] },
        "values": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "field", "message", "provenance"],
      "properties": {
        "code": { "enum": ["API_CONTRACT_UNSPECIFIED", "CONTRACT_CONFLICT", "UNSTRUCTURED_ACCEPTANCE_CRITERION"] },
        "field": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
      }
    }
  }
}
