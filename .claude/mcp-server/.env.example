# Copy this file to .env and fill in your credentials.
# Never commit .env to git.

# Kit token — required for /feature-from-confluence (also set in root .env).
KIT_TOKEN=

# Option A — LDAP / Active Directory login (same as logging into Confluence)
CONFLUENCE_USER=yourname    # username only, NOT email (e.g. your-username, not your-username@company.com)
CONFLUENCE_PASS=your_password

# Option B — Personal Access Token (Profile → Personal Access Tokens in Confluence)
# If set, this takes priority over user+pass.
# CONFLUENCE_TOKEN=your_pat_token
