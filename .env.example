# Copy this file to .env and fill in your credentials.
# Never commit .env to git.

# Kit token — set automatically by `npm run workflow:login`, or fill in manually.
# Required for /feature-from-confluence. Obtain yours from the kit maintainer.
KIT_TOKEN=

# Confluence credentials (also copy the Confluence block to .claude/mcp-server/.env)
# Option A — LDAP / Active Directory login (same as logging into Confluence)
# CONFLUENCE_USER=yourname    # username only, NOT email
# CONFLUENCE_PASS=your_password

# Option B — Personal Access Token (Profile → Personal Access Tokens in Confluence)
# If set, this takes priority over user+pass.
# CONFLUENCE_TOKEN=your_pat_token

# Supabase — used by `npm run sync` to report install-based versions (Phần B).
# Use the PUBLIC anon credentials (anon key is safe to expose — RLS on the
# `installs` table is what protects it). Copy real values into your OWN .env
# (the kit does NOT borrow kit-dashboard's config). Find them in the Supabase
# dashboard → Project Settings → API.
# If either is missing, `npm run sync` still syncs files and only skips the
# install report (with a warning).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
