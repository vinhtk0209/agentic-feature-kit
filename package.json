{
  "name": "feature-from-confluence-kit",
  "version": "3.25.0",
  "private": true,
  "bin": {
    "workflow": "bin/workflow.ts"
  },
  "description": "Claude Code agentic workflow kit: a spec becomes convention-compliant, PR-ready code with human-in-the-loop gates, a deterministic self-test toolchain, and a self-improvement loop.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:feature": "npx tsx .claude/integrations/lint-feature.ts",
    "eval:feature": "npx tsx .claude/integrations/eval-feature.ts",
    "eval:ab": "npx tsx .claude/integrations/eval-ab.ts",
    "corpus:add": "npx tsx .claude/integrations/corpus-manager.ts add",
    "corpus:list": "npx tsx .claude/integrations/corpus-manager.ts list",
    "corpus:validate": "npx tsx .claude/integrations/corpus-manager.ts validate",
    "model:chain": "npx tsx .claude/integrations/model-config.ts",
    "hooks:list": "npx tsx .claude/integrations/hooks.ts --list",
    "build:copilot": "npx tsx scripts/build-copilot-edition.ts",
    "changelog": "npx tsx scripts/changelog.ts",
    "release": "npx tsx scripts/changelog.ts --write",
    "release:dry": "npx tsx scripts/changelog.ts --dry",
    "git-hooks:install": "git config core.hooksPath .githooks && echo \"✅ git hooks enabled (.githooks) — commit messages now validated\"",
    "verify:browser": "npx tsx .claude/integrations/playwright-runner.ts",
    "check:ownership": "npx tsx .claude/integrations/check-ownership.ts",
    "check:lessons": "npx tsx .claude/integrations/lesson-registry.ts --summary",
    "check:lessons-sync": "npx tsx .claude/integrations/lesson-registry.ts --sync-check",
    "check:playwright-token": "npx tsx .claude/integrations/version-check.ts --playwright",
    "check:amendments": "npx tsx .claude/integrations/improve-trigger.ts --status",
    "sync": "npx tsx scripts/sync-to-targets.ts",
    "sync:dry": "npx tsx scripts/sync-to-targets.ts --dry-run",
    "sync:rollback": "npx tsx scripts/sync-to-targets.ts --rollback",
    "workflow:kpis": "npx tsx .claude/integrations/kpi-report.ts",
    "workflow:dashboard": "npx tsx .claude/integrations/kpi-report.ts --dashboard",
    "workflow:index": "npx tsx .claude/integrations/feature-index.ts",
    "workflow:digest": "npx tsx .claude/integrations/feature-digest.ts",
    "setup": "node -e \"require('os').platform()==='win32' ? require('child_process').execSync('powershell -ExecutionPolicy Bypass -File setup.ps1', {stdio:'inherit'}) : require('child_process').execSync('bash setup.sh', {stdio:'inherit'})\"",
    "setup:env": "bash scripts/setup-env.sh",
    "workflow:login": "npx tsx bin/workflow.ts login",
    "workflow:init": "npx tsx bin/workflow.ts init",
    "workflow:update": "npx tsx bin/workflow.ts update",
    "workflow:status": "npx tsx bin/workflow.ts status",
    "version:check": "npx tsx .claude/integrations/version-check.ts",
    "test:lint-feature": "npx tsx .claude/integrations/lint-feature.test.ts",
    "test:ownership": "npx tsx .claude/integrations/check-ownership.test.ts",
    "test:integration": "npx tsx .claude/integrations/integration.test.ts",
    "test:record-verify": "npx tsx .claude/integrations/record-verify.test.ts",
    "test:b11-runner": "npx tsx .claude/integrations/b11-runner.test.ts",
    "test:b11-runner-order": "npx tsx .claude/integrations/b11-runner.order.test.ts",
    "test:eval-feature": "npx tsx .claude/integrations/eval-feature.test.ts",
    "test:eval-ab": "npx tsx .claude/integrations/eval-ab.test.ts",
    "test:eval-regression": "npx tsx .claude/integrations/eval-regression.test.ts",
    "test:lesson-registry": "npx tsx .claude/integrations/lesson-registry.test.ts",
    "test:improve-trigger": "npx tsx .claude/integrations/improve-trigger.test.ts",
    "test:prompt-budget": "npx tsx .claude/integrations/prompt-budget.test.ts",
    "test:contract-probe": "npx tsx .claude/integrations/contract-probe.test.ts",
    "test:contract-probe-realfile": "npx tsx .claude/integrations/contract-probe.realfile.test.ts",
    "test:contract-probe-defer": "npx tsx .claude/integrations/contract-probe.defer.test.ts",
    "test:continuous-assurance": "npx tsx .claude/integrations/continuous-assurance.test.ts",
    "test:spec-intake": "npx tsx .claude/integrations/spec-ir.test.ts && npx tsx .claude/integrations/spec-intake.cli.test.ts",
    "test:spec-intake-wiring": "npx tsx .claude/commands/feature-from-confluence.spec-ir-wiring.test.ts",
    "test:spec-intake-confluence-golden": "npx tsx .claude/integrations/spec-intake-confluence.golden.test.ts",
    "test:spec-intake-confluence": "npx tsx .claude/integrations/spec-intake-confluence.test.ts",
    "test:evidence-bundle-wiring": "npx tsx .claude/commands/feature-from-confluence.evidence-wiring.test.ts",
    "test:split-feature-wiring": "npx tsx .claude/commands/split-feature.wiring.test.ts",
    "test:baseline-http-gen": "npx tsx .claude/integrations/baseline-http-gen.test.ts",
    "test:d-cross-2": "npx tsx .claude/integrations/d-cross-2.test.ts",
    "test:learned-config": "npx tsx .claude/integrations/learned-config.test.ts",
    "test:friction-meter": "npx tsx .claude/integrations/friction-meter.test.ts",
    "test:feature-index": "npx tsx .claude/integrations/feature-index.test.ts",
    "test:feature-digest": "npx tsx .claude/integrations/feature-digest.test.ts",
    "test:memory": "npx tsx .claude/integrations/memory.test.ts",
    "test:regression-corpus": "npx tsx .claude/integrations/regression-corpus.test.ts",
    "test:corpus-manager": "npx tsx .claude/integrations/corpus-manager.test.ts",
    "test:model-config": "npx tsx .claude/integrations/model-config.test.ts",
    "test:hooks": "npx tsx .claude/integrations/hooks.test.ts",
    "test:changelog": "npx tsx scripts/changelog.test.ts",
    "test:sync-rollback": "npx tsx scripts/sync-rollback.test.ts",
    "test:build-copilot": "npx tsx scripts/build-copilot-edition.test.ts",
    "test:telemetry": "npx tsx .claude/integrations/telemetry.test.ts",
    "test:playwright-runner": "npx tsx .claude/integrations/playwright-runner.test.ts",
    "test:design-matcher": "npx tsx .claude/integrations/design-matcher.test.ts",
    "test:figma-rest-source": "npx tsx .claude/integrations/figma-rest-source.test.ts",
    "test:design-intake": "npx tsx .claude/integrations/design-intake.test.ts",
    "test:design-match-handoff": "npx tsx .claude/integrations/design-match-handoff.test.ts",
    "test:design-to-ui-wiring": "npx tsx .claude/commands/feature-from-confluence.design-to-ui-wiring.test.ts",
    "test:design-to-ui-dry-run": "npx tsx .claude/integrations/design-to-ui-dry-run.test.ts",
    "test:kit": "npm run test:lint-feature && npm run test:ownership && npm run test:integration && npm run test:record-verify && npm run test:b11-runner && npm run test:b11-runner-order && npm run test:eval-feature && npm run test:eval-ab && npm run test:eval-regression && npm run test:lesson-registry && npm run test:improve-trigger && npm run test:prompt-budget && npm run test:contract-probe && npm run test:contract-probe-realfile && npm run test:contract-probe-defer && npm run test:continuous-assurance && npm run test:baseline-http-gen && npm run test:d-cross-2 && npm run test:learned-config && npm run test:friction-meter && npm run test:feature-index && npm run test:feature-digest && npm run test:memory && npm run test:regression-corpus && npm run test:corpus-manager && npm run test:model-config && npm run test:hooks && npm run test:changelog && npm run test:sync-rollback && npm run test:build-copilot && npm run test:telemetry && npm run test:playwright-runner && npm run test:design-matcher && npm run test:figma-rest-source && npm run version:check && npm run workflow:index -- --check && npx tsx .claude/integrations/prompt-budget.ts --gate && npm run check:lessons-sync",
    "test": "npm run test:kit"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^4.9.5",
    "playwright": "^1.60.0",
    "@playwright/test": "^1.60.0",
    "@axe-core/playwright": "^4.11.3",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
