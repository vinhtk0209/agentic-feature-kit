# Dependencies
node_modules/
.claude/mcp-server/node_modules/
.claude/mcp-workflow/node_modules/

# Generated edition bundles (npm run build:copilot)
dist/

# Secrets — NEVER commit. Copy .env.example → .env and fill locally.
.env
.env.local
.env.private
.claude/mcp-server/.env
.claude/mcp-workflow/.env

# Machine-local operational sync targets; tracked defaults remain public-safe examples.
sync.config.local.json

# Playwright auth (local only)
.env.playwright

# Workflow runtime state (regenerated per session/feature)
docs/specs/.current-feature
docs/specs/.feedback-history.md
docs/specs/.kpi-history.jsonl
# NOTE: docs/specs/INDEX.md is intentionally committed — `test:kit`'s
# `workflow:index --check` gate compares against it, so it must exist on a fresh clone.

# Claude Code local session state (machine-specific paths, not portable)
.claude/settings.local.json

# OS / editor
.DS_Store
*.log

# Local backups (e.g. command-file snapshots before an edit)
*.bak
*.bak.*

# Kept local ON PURPOSE (not published to this public repo): internal design doc.
# Ignored so `git clean -fd` can't delete it; content stays off GitHub.
docs/design/self-training-loop.md

# NOTE — sync-target tooling tracking (informational; does NOT affect this repo's ignores).
# This kit's .claude/ toolchain is the source of truth here and IS committed. The two consuming
# repos handle the SYNCED copy differently, per their own .gitignore — know this before syncing:
#   - example-learning-app  → TRACKS .claude/ (synced kit files are committed on its branch).
#   - example-authoring-app → GITIGNORES the kit toolchain (.claude/integrations|templates|_content,
#     the synced commands, prompt-evolution.md). There it is LOCAL-ONLY/untracked: `npm run sync` or a
#     manual copy updates the working-tree files (fix is live immediately), but there is NO commit and
#     `git add` refuses without -f. Don't force-add against that intent, and don't expect `git restore`
#     to bring those files back — re-run sync/copy from the kit instead.
