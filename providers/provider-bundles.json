{
  "schemaVersion": "1.0.0",
  "product": "agentic-feature-kit",
  "bundleVersion": "0.2.0",
  "sharedCoreVersion": "1.0.0",
  "sourceMode": "monorepo",
  "distribution": {
    "builder": "scripts/build-provider-bundles.ts",
    "outputRoot": "dist/provider-bundles",
    "archiveFormat": "zip",
    "checksumFile": "SHA256SUMS",
    "manifest": "bundle-manifest.json",
    "nodeEngine": ">=20",
    "runtime": {
      "projectIntelligence": "runtime/project-intelligence.cjs",
      "workflowOrchestrator": "runtime/workflow-orchestrator.cjs"
    }
  },
  "providers": [
    {
      "id": "codex",
      "root": "providers/codex/agentic-feature-kit",
      "manifest": ".codex-plugin/plugin.json",
      "skill": "skills/project-intelligence/SKILL.md",
      "agent": null,
      "orchestratorSkill": "skills/workflow-orchestrator/SKILL.md",
      "orchestratorAgent": null
    },
    {
      "id": "claude",
      "root": "providers/claude/agentic-feature-kit",
      "manifest": ".claude-plugin/plugin.json",
      "skill": "skills/project-intelligence/SKILL.md",
      "agent": "agents/project-intelligence.md",
      "orchestratorSkill": "skills/workflow-orchestrator/SKILL.md",
      "orchestratorAgent": "agents/workflow-orchestrator.md"
    },
    {
      "id": "copilot",
      "root": "providers/copilot/agentic-feature-kit",
      "manifest": null,
      "skill": ".github/skills/project-intelligence/SKILL.md",
      "agent": ".github/agents/project-intelligence.agent.md",
      "orchestratorSkill": ".github/skills/workflow-orchestrator/SKILL.md",
      "orchestratorAgent": ".github/agents/workflow-orchestrator.agent.md"
    }
  ]
}
